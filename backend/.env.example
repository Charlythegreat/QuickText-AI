# =============================================================================
# QuickText AI Backend - Environment Variables (Free & Unlimited Version)
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!
# =============================================================================

# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# For browser extensions, use: chrome-extension://YOUR_EXTENSION_ID
# Use * to allow all origins (fine for free version)
CORS_ORIGINS=*

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Set the provider to use: groq (default), openai, or azure
LLM_PROVIDER=groq

# Shared LLM settings
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Groq Configuration (Default - FREE tier available)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
# Uses OpenAI-compatible endpoint: https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# Available Groq models:
# - llama3-70b-8192 (recommended - best quality)
# - llama3-8b-8192 (faster, lower quality)
# - mixtral-8x7b-32768 (good for longer context)
# - gemma-7b-it (Google's Gemma model)

# -----------------------------------------------------------------------------
# OpenAI Configuration (Alternative)
# -----------------------------------------------------------------------------
# Uncomment and set LLM_PROVIDER=openai to use OpenAI
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration (Alternative)
# -----------------------------------------------------------------------------
# Uncomment and set LLM_PROVIDER=azure to use Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# =============================================================================
# Rate Limiting
# =============================================================================
# Generous limits for free version
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=combined
